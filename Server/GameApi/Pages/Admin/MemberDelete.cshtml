@page "/admin/members/delete"
@model MagicOnline.GameApi.Pages.Admin.MemberDeleteModel
<div class="breadcrumb"><a href="/admin/members">회원 관리</a> / 회원 삭제 확인</div>
<section class="panel"><h1>회원 삭제 확인</h1>
<p>선택한 회원을 회원 목록에서 제거하고 로그인과 기존 접속 세션을 차단합니다. 같은 로그인 ID로 새로 가입할 수 있습니다.</p>
<p class="hint">대전·정산·재화·구매 기록과 회원 UUID는 보존합니다. 삭제 사유와 대상은 관리자 감사 기록에 남습니다. 이 화면에서 복원하는 기능은 제공하지 않습니다.</p>
@if(Model.Error!=null){<p class="error" role="alert">@Model.Error</p>}
@if(Model.Candidates.Count>0){
<div class="table-scroll"><table><thead><tr><th>로그인 ID</th><th>닉네임</th><th>회원 UUID</th><th>상태</th></tr></thead><tbody>
@foreach(var member in Model.Candidates){<tr><td>@member.Login</td><td>@member.Nickname</td><td>@member.Id</td><td>@(member.Deleted ? "이미 삭제됨" : member.HasMatch ? "준비·진행·미정산 경기 있음" : "삭제 가능")</td></tr>}
</tbody></table></div>
@if(Model.Blocked){<p class="error" role="alert">미종료 경기가 있는 회원이 포함돼 있습니다. 해당 경기를 종료하거나 목록에서 다른 회원만 선택해 주세요. 선택한 회원 전체의 삭제를 중단합니다.</p>}
else{
<form method="post" asp-page="/Admin/MemberDelete" asp-page-handler="Delete" class="chart-form">
@for(int i=0;i<Model.Ids.Length;i++){<input type="hidden" name="Ids" value="@Model.Ids[i]"><input type="hidden" name="ExpectedLogins" value="@Model.ExpectedLogins.ElementAtOrDefault(i)">}
<div class="chart-fields"><label>삭제 사유<input asp-for="Reason" maxlength="200" required placeholder="예: 실수로 생성한 테스트 계정"></label>
<label>확인 문구<input asp-for="Confirmation" required autocomplete="off" placeholder="삭제 를 입력하세요"></label></div>
<div class="chart-actions"><button class="primary" type="submit">선택한 @Model.Candidates.Count 명 삭제</button><a class="button" href="/admin/members">취소</a></div>
</form>}}
else{<a class="button" href="/admin/members">회원 목록으로</a>}
</section>
