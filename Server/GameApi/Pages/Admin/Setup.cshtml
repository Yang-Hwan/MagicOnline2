@page "/admin/setup"
@model MagicOnline.GameApi.Pages.Admin.SetupModel
@{ ViewData["Title"] = "최초 관리자 설정"; }
<section class="auth-card"><div class="eyebrow">INITIAL SETUP</div><h1>최초 관리자 설정</h1><p class="muted">개발 PC에서 한 번만 사용할 수 있습니다. 계정 생성 후 이 화면은 닫힙니다.</p>@if(Model.Error!=null){<p class="error" role="alert">@Model.Error</p>}<form method="post"><label for="LoginId">관리자 ID</label><input asp-for="LoginId" autocomplete="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9_]+" required><p class="hint">영문·숫자·밑줄 3~32자</p><label for="Password">비밀번호</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><p class="hint">12~128자 · 게임 비밀번호와 별도로 설정</p><label for="ConfirmPassword">비밀번호 확인</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><button class="primary full" type="submit">관리자 계정 생성</button></form></section>
