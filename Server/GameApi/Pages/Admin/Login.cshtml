@page "/admin/login"
@model MagicOnline.GameApi.Pages.Admin.LoginModel
@{ ViewData["Title"] = "관리자 로그인"; }
<section class="auth-card"><div class="eyebrow">OPERATIONS CONSOLE</div><h1>관리자 로그인</h1><p class="muted">@(Model.DevelopmentLogin ? "개발 중에는 관리자 ID만 입력하면 됩니다." : "게임 계정과 분리된 관리자 계정으로 로그인하세요.")</p>@if(Model.Error!=null){<p class="error" role="alert">@Model.Error</p>}<form method="post"><label for="LoginId">관리자 ID</label><input asp-for="LoginId" autocomplete="username" minlength="3" maxlength="32" pattern="[A-Za-z0-9_]+" required>@if(!Model.DevelopmentLogin){<label for="Password">비밀번호</label><input asp-for="Password" type="password" autocomplete="current-password" maxlength="128" required>}<button class="primary full" type="submit">로그인</button></form>@if(Model.CanSetup){<a class="setup-link" href="/admin/setup">최초 관리자 계정 설정</a>}@if(Model.DevelopmentLogin){<p class="hint">최초 접속이면 입력한 ID로 개발용 관리자가 생성됩니다.<br>이후에는 같은 ID로 로그인하세요.</p>}<p class="hint">세션은 30분 후 만료됩니다.</p></section>
