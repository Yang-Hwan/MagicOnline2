@page "/admin/{section?}"
@model MagicOnline.GameApi.Pages.Admin.IndexModel
<div class="breadcrumb">운영 콘솔 / @Model.Title</div><div class="page-head"><div><h1>@Model.Title</h1><p class="muted">@Model.Description</p></div><span class="badge">@(Model.Planned ? "개발 예정" : Model.Section=="charts" ? "실제 데이터 · 차트 관리" : "실제 데이터 · 조회 전용")</span></div>
@if(Model.Dashboard is {} d) {
<div class="stats"><section class="stat"><span>전체 회원</span><strong>@d.Members.ToString("N0")</strong><small>개발용 검사 계정 포함</small></section><section class="stat"><span>오늘 신규 회원</span><strong>@d.NewMembers.ToString("N0")</strong><small>한국 시간 기준</small></section><section class="stat"><span>진행 상태 경기</span><strong>@d.Playing.ToString("N0")</strong><small>서버 저장 상태 기준</small></section><section class="stat"><span>결과 불일치</span><strong>@d.Disputed.ToString("N0")</strong><small>미정산 분쟁</small></section><section class="stat"><span>정산 영수증</span><strong>@d.Receipts.ToString("N0")</strong><small>누적 발급 건수</small></section></div>
<p class="hint">DB 조회 시각 @d.DatabaseTime KST · 실제 동시 접속자 수와 일별 활동·매출 지표는 별도 수집 기능 추가 후 제공합니다.</p>
}
@if(Model.Planned) {
<section class="panel planned"><div class="eyebrow">NEXT DEVELOPMENT</div><h2>@Model.Title 기능을 준비 중입니다</h2>@if(Model.Section=="payments"){<p>상품 · Google Play/App Store 주문 · 서버 검증 · 지급 대기 · 환불·취소 · 스토어 통지</p><p class="muted">현재 실제 결제를 수집하거나 재화를 지급하지 않습니다.</p>}else if(Model.Section=="operations"){<p>공지 작성 · 점검 예약 · 최소 지원 버전 · 적용 이력</p>}else{<p>회원 운영 메모 · 문의 접수 · 신고 · 담당자 · 경기/주문 연결</p>}<a class="button" href="/admin">대시보드로</a></section>
}
@if(Model.Section is "members" or "matches" or "wallet") {
<form method="get" class="filters"><label class="search">검색<input name="q" value="@Model.Q" maxlength="128" placeholder="@(Model.Section=="members" ? "UUID · 로그인 ID · 닉네임" : Model.Section=="matches" ? "경기 ID · 참가자 UUID · 닉네임" : "회원 UUID · 로그인 ID · 요청 키 · 경기 ID")"></label><label>필터<select name="state"><option value="">전체</option>@if(Model.Section=="members"){<option value="active" selected="@(Model.State=="active")">정상</option><option value="disabled" selected="@(Model.State=="disabled")">제한</option>}else if(Model.Section=="matches"){<option value="registered" selected="@(Model.State=="registered")">등록/준비</option><option value="playing" selected="@(Model.State=="playing")">진행 중</option><option value="disputed" selected="@(Model.State=="disputed")">결과 불일치</option><option value="applied" selected="@(Model.State=="applied")">정산 완료</option>}else{<option value="coin" selected="@(Model.State=="coin")">Coin 변동</option><option value="jem" selected="@(Model.State=="jem")">Jem 변동</option>}</select></label><button class="primary" type="submit">검색</button><a class="button" href="/admin/@Model.Section">초기화</a></form>
}
@if(Model.Section=="charts") {
<nav class="tabs" aria-label="차트 종류">@foreach(var item in new[]{("SkillMatch","경기장 규칙"),("Attendance","출석 보상"),("CommonCode","공통 코드")}){<a class="@(Model.Name==item.Item1 ? "selected" : "")" href="/admin/charts?name=@item.Item1">@item.Item2</a>}</nav><p class="notice">저장한 차트는 즉시 서버에 반영됩니다. 게임은 재로그인 후 새 값을 읽습니다.</p>@if(TempData["ChartSuccess"] is string message){<p class="notice" role="status">@message</p>}@if(User.IsInRole("Owner") || User.IsInRole("Operator")){<p><a class="button primary" href="/admin/charts/edit?name=@Model.Name">항목 추가</a></p>}
}
@if(Model.Extra is {} extra) {<section class="panel"><h2>@(Model.Section=="system" ? "관리자 계정" : "잔액 · 원장 대조")</h2><partial name="_AdminTable" model="extra" /></section>}
@if(Model.Table is {} table) {<section class="panel"><div class="panel-head"><h2>@(Model.Section=="dashboard" ? "결과 불일치 경기" : Model.Section=="system" ? "관리자 감사 기록" : Model.Section=="charts" ? Model.Name : "조회 결과")</h2><span class="muted">@table.Rows.Count 건@(Model.Section=="charts" ? "" : " / 페이지당 최대 30건")</span></div>@if(Model.Section=="charts"){<div class="table-scroll"><table><thead><tr>@foreach(var col in table.Columns){<th scope="col">@col</th>}<th scope="col">작업</th></tr></thead><tbody>@for(int row=0;row<table.Rows.Count;row++){<tr>@foreach(var value in table.Rows[row]){<td>@value</td>}<td>@if(User.IsInRole("Owner") || User.IsInRole("Operator")){<a href="/admin/charts/edit?name=@Model.Name&amp;row=@row">수정</a>}else{<span class="muted">조회 전용</span>}</td></tr>}</tbody></table></div>}else{<partial name="_AdminTable" model="table" />}</section>@if(Model.Section is "members" or "matches" or "wallet" or "system"){<nav class="pagination" aria-label="페이지 이동">@if(Model.Number>1){<a class="button" href="@Model.PageUrl(Model.Number-1)">이전</a>}<span>@Model.Number 페이지</span>@if(table.HasNext){<a class="button" href="@Model.PageUrl(Model.Number+1)">다음</a>}</nav>}}
@if(Model.Section=="system" && !User.IsInRole("Owner")){<div class="notice">관리자 계정과 감사 기록은 최고 관리자만 조회할 수 있습니다.</div>}
